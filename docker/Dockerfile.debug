# STEP2: BUILD THE FRONTEND
FROM node:18-alpine AS builder_frontend
WORKDIR /home/
COPY package.json /home/
RUN apk add make git gzip brotli && \
    npm install --legacy-peer-deps
COPY client /home/client
COPY config /home/config
COPY public /home/public
COPY .assets /home/.assets
COPY Makefile webpack.config.js .babelrc .eslintrc.json /home/
RUN make build_frontend && \
    cd public && make compress

# STEP3: BUILD THE BACKEND
FROM golang:1.23-bookworm AS builder_backend
WORKDIR /home/

RUN apt-get update > /dev/null && \
    apt-get install -y libvips-dev curl make > /dev/null 2>&1 && \
    apt-get install -y libjpeg-dev libtiff-dev libpng-dev libwebp-dev libraw-dev libheif-dev libgif-dev

COPY --from=builder_frontend /home/ ./
COPY . .
# The commit this image is built from, for the About page's source link; when
# empty, `make build_init` reads it from git.
ARG BUILD_REF=
# COPY cmd /home/cmd
# COPY server /home/server
# COPY embed.go go.mod go.sum /home/

RUN BUILD_REF="${BUILD_REF}" make build_init && \
    make build_backend && \
    mkdir -p ./dist/data/state/config/ && \
    cp config/config.json ./dist/data/state/config/config.json

# STEP4: Create the prod image from the build
FROM debian:stable-slim
RUN apt-get update > /dev/null && \
    apt-get install -y --no-install-recommends apt-utils ca-certificates curl emacs-nox ffmpeg zip poppler-utils libheif-dev
# org-mode: html export
COPY --from=builder_backend /home/server/.assets/emacs/htmlize.el /usr/share/emacs/site-lisp/htmlize.el
# org-mode: markdown export
COPY --from=builder_backend /home/server/.assets/emacs/ox-gfm.el /usr/share/emacs/site-lisp/ox-gfm.el
# Cleanup
RUN find /usr/share/ -name 'doc' | xargs rm -rf && \
    find /usr/share/emacs -name '*.pbm' | xargs rm -f && \
    find /usr/share/emacs -name '*.png' | xargs rm -f && \
    find /usr/share/emacs -name '*.xpm' | xargs rm -f
COPY --from=builder_backend /home/dist/ /app/
WORKDIR "/app"
RUN useradd filestash && \
    chown -R filestash:filestash /app/ && \
    find /app/data/ -type d -exec chmod 770 {} \; && \
    find /app/data/ -type f -exec chmod 760 {} \; && \
    chmod 730 /app/filestash && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /tmp/*
USER filestash
CMD ["/app/filestash"]
EXPOSE 8334
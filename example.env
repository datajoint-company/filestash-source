# Filestash only takes bcrypt hash for this env instead of plain text, to get this hash
# 1. You can run filestash locally and reset the ./dist/state/config/config.json["auth"]
# then go to https://localhost:8334/admin to set your password, then the hash will be generated
# 2. Or you can use this tool https://bcrypt-generator.com/
ADMIN_PASSWORD=


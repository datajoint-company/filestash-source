FS_S3_OIDC_CLIENT_ID='works'
FS_S3_OIDC_CLIENT_SECRET='xxx'
FS_S3_OIDC_CLIENT_AUD='workss3'
FS_S3_OIDC_TOKEN_ENDPOINT='https://keycloak.example.org/realms/datajoint/protocol/openid-connect/token'
FS_S3_OIDC_DEFAULT_ROLE_ARN='arn:aws:iam::111111111111:role/acme-lab_ephys_researcher'
FS_S3_OIDC_DEFAULT_BUCKET='example-bucket'
FS_S3_OIDC_DEFAULT_REGION='us-east-2'
FS_S3_OIDC_SUPPORT_GROUP='datajoint'
FS_S3_OIDC_STS_DURATION=3600
FS_IFRAME_OVERRIDE='https://portal.example.org'
# Injected into the page as /custom.css on both frontends. Set from deployment config
# so UI tweaks are versioned in git instead of living in the Admin Console, whose
# state directory the kubernetes deployment does not persist.
FS_CUSTOM_CSS=''
# Files-tab UX. Defaults are filestash's own (upload button hidden, no refresh
# after upload, grid view), which leave desktop users with only a hover-only
# drop overlay and no feedback when an upload finishes.
FS_UPLOAD_BUTTON='true'
FS_REFRESH_AFTER_UPLOAD='true'
FS_FILEPAGE_DEFAULT_VIEW='list'
# Chunked uploads, in MB. 0 (filestash's default) means no chunking, so a large
# upload cannot resume after a network blip — set it for big instrument files.
FS_UPLOAD_CHUNK_SIZE='64'
FS_FILEPAGE_DEFAULT_SORT='date'
# Timeout for 'download as zip' of a folder, in seconds. Default 60 is short for
# a large study prefix.
FS_ZIP_TIMEOUT='600'
# Shared links. On by default in filestash; a deployment fronting regulated data
# may want them off.
FS_SHARE_ENABLE='true'
APPLICATION_URL=

# Filestash only takes bcrypt hash for this env instead of plain text, to get this hash
# 1. You can run filestash locally and reset the ./dist/state/config/config.json["auth"]
# then go to https://localhost:8334/admin to set your password, then the hash will be generated
# 2. Or you can use this tool https://bcrypt-generator.com/
ADMIN_PASSWORD=

